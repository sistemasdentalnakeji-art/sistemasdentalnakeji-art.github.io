# Copia este archivo como .env.local (desarrollo) o .env.production (build) y pega la URL
# de tu aplicación web de Google Apps Script. Ver integrations/google-calendar/README.md
# Nota: esta URL es pública (la usa el navegador); no es una clave secreta.
VITE_BOOKING_ENDPOINT=

# Reseñas de Google (api/reviews.ts). Estas SÍ son secretas: se configuran en Vercel > Settings > Environment
# Variables, nunca en un archivo del repositorio ni con prefijo VITE_. La llave se restringe a "Places API (New)".
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
