{
  "name": "dental-nakeji",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:app": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server",
    "build": "npm run build:app && node scripts/prerender.mjs",
